    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || {};\n\nconst fieldType = body.field_type || null;\nconst originalValue = (body.value || '').toString().trim();\nconst table = body.context?.table || null;\nconst rowId = body.context?.row_id != null ? Number(body.context.row_id) : null;\n\nconst isEmpty = originalValue.length === 0;\n\nconst validFieldTypes = ['internal_note', 'comment'];\nconst isValidFieldType = validFieldTypes.includes(fieldType);\n\nreturn {\n  json: {\n    field_type: fieldType,\n    original_value: originalValue,\n    table: table,\n    row_id: rowId,\n    is_empty: isEmpty,\n    is_valid_field_type: isValidFieldType,\n    skip_llm: isEmpty || !isValidFieldType\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        -128
      ],
      "id": "b0b4697e-d03a-4ee1-9a61-c4310c174191",
      "name": "нормализация + флаги"
    },
    {
      "parameters": {
        "jsCode": "const skipLlm = $('нормализация + флаги').item.json.skip_llm;\n\nlet cleaned;\nif (skipLlm) {\n  cleaned = $('нормализация + флаги').item.json.original_value || '';\n} else {\n  const rawOutput = ($input.item.json.text || $input.item.json.output || '').toString();\n  cleaned = rawOutput.trim();\n  cleaned = cleaned.replace(/^[\"'«»]+|[\"'«»]+$/g, '');\n  cleaned = cleaned.replace(/^(Вот|Ответ|Результат)[:\\s-]*/i, '');\n}\n\nconst fieldType = $('нормализация + флаги').item.json.field_type;\nconst maxLength = fieldType === 'comment' ? 255 : 100000;\n\nif (cleaned.length > maxLength) {\n  cleaned = cleaned.substring(0, maxLength - 3) + '...';\n}\n\nreturn { json: { result: cleaned } };"
      },
      "type": "n8n-nodes-base.code",
