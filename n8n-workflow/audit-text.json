    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text ?? $input.first().json.output ?? '';\nlet cleaned = raw.trim();\ncleaned = cleaned.replace(/^```json\\s*/i, '').replace(/```\\s*$/i, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { contains_pii: true, reason: 'Не удалось распарсить ответ LLM: ' + cleaned.slice(0, 200) };\n}\n\nreturn [{ json: {\n  contains_pii: !!parsed.contains_pii,\n  reason: parsed.reason || 'Не указано'\n}}];"
      },
